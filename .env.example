# ============================================================
# PRAHARI-AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and configure appropriately.
# NEVER commit your real '.env' file to version control.
# ============================================================

# Environment Mode: 'development' or 'production'
# In production, strong secrets are strictly enforced at startup.
PRAHARI_ENV=development

# Server Binding
HOST=0.0.0.0
PORT=8001

# JWT Secret Key for Admin Authentication & Role-Based Access Control (RBAC)
# Minimum 32 characters required in production mode (RFC 7518 HS256 compliance).
PRAHARI_SECRET_KEY=change_this_to_a_secure_32_char_secret_for_production_use!

# Bootstrap Admin Password (Used only on first database initialization)
# Must be changed immediately upon deployment via the Admin Panel or API.
PRAHARI_ADMIN_PASSWORD=Admin@Prahari2026!

# GPU / Hardware Acceleration (Optional)
# Leave blank for automatic CUDA detection with CPU fallback.
# CUDA_VISIBLE_DEVICES=0
